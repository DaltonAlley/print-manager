# Keep the default loopback publication unless an authenticated TLS reverse proxy protects the app.
PRINT_MANAGER_HOST=127.0.0.1
PRINT_MANAGER_DATA_DIR=./data
# Container path containing SQLite, attachments, and managed branding.
PRINT_MANAGER_DATA_ROOT=/data
# IANA timezone used for calendar dates such as Today and default due dates.
SHOP_TIME_ZONE=America/New_York
# Per production file; defaults to 100 MiB.
ATTACHMENT_MAX_BYTES=104857600
RUST_LOG=info

# Set both values to enable email. Keep the API key out of this file in source control.
# RESEND_API_KEY=re_...
# RESEND_FROM=Print Shop <quotes@example.com>
